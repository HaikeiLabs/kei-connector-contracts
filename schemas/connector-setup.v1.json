  {
    "schema": "kei.connector-setup/v1",
    "provider": "tito",
    "auth": [
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "account_slug",
        "label": "Tito account slug",
        "type": "string",
        "location": "config",
        "required": true,
        "secret": false,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      {
        "name": "api_token",
        "label": "Tito API token",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^\\S+$",
        "min_length": 20,
        "max_length": 256
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
    "provider": "notion",
    "auth": [
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "api_token",
        "label": "Notion internal integration token",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^(ntn|secret)_[A-Za-z0-9]+$",
        "min_length": 20,
        "max_length": 256
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
    "provider": "discord",
    "auth": [
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "bot_token",
        "label": "Discord bot token",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "min_length": 50,
        "max_length": 256
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
    "provider": "grafana",
    "auth": [
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "base_url",
        "label": "Grafana URL",
        "type": "https_url",
        "location": "grafana",
        "required": true,
        "secret": false,
        "max_length": 2048
      },
      {
        "name": "service_account_token",
        "label": "Grafana service account token",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^glsa_[A-Za-z0-9]+_[A-Za-z0-9]+$",
        "min_length": 20,
        "max_length": 256
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
    "provider": "skills_repo",
    "auth": [
      {
        "credential_source": "oauth",
        "account_models": [
          "per_user"
        ],
        "default_account_model": "per_user"
      },
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "repo_url",
        "label": "Skills repository URL",
        "type": "https_url",
        "location": "config",
        "required": true,
        "secret": false,
        "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/\\.?[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}$",
        "max_length": 2048
      },
      {
        "name": "ref",
        "label": "Branch, tag, or commit",
        "type": "string",
        "location": "config",
        "required": false,
        "secret": false,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$",
        "default": "main"
      },
      {
        "name": "subdirectory",
        "label": "Skills folder",
        "type": "string",
        "location": "config",
        "required": false,
        "secret": false,
        "pattern": "^(/|[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,7}/?)$",
        "default": "skills/"
      },
      {
        "name": "token",
        "label": "GitHub token with read access to repository contents",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^\\S+$",
        "min_length": 20,
        "max_length": 512,
        "credential_sources": [
          "opaque_ref"
        ]
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
    "provider": "crm",
    "auth": [
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "base_url",
        "label": "CRM Worker origin",
        "type": "https_url",
        "location": "config",
        "required": true,
        "secret": false,
        "max_length": 2048
      },
      {
        "name": "assertion_audience",
        "label": "Service assertion audience",
        "type": "string",
        "location": "config",
        "required": true,
        "secret": false,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
      },
      {
        "name": "allowed_actions",
        "label": "Allowed actions",
        "type": "string_list",
        "location": "config",
        "required": false,
        "secret": false,
        "pattern": "^(read|create|update)$",
        "default": [
          "read"
        ]
      },
      {
        "name": "allowed_resources",
        "label": "Allowed resources",
        "type": "string_list",
        "location": "config",
        "required": false,
        "secret": false,
        "pattern": "^(leads|customers|investors)(/\\*)?$",
        "default": [
          "leads",
          "customers"
        ]
      },
      {
        "name": "api_key",
        "label": "CRM connector API key",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^\\S+$",
        "min_length": 32,
        "max_length": 512
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
    "provider": "http_api",
    "auth": [
      {
        "credential_source": "on_behalf_of",
        "account_models": [
          "per_user"
        ],
        "default_account_model": "per_user"
      },
      {
        "credential_source": "opaque_ref"
      }
    ],
    "fields": [
      {
        "name": "http_api",
        "label": "HTTP API registration",
        "type": "http_api",
        "location": "http_api",
        "required": true,
        "secret": false
      },
      {
        "name": "client_id",
        "label": "Client ID",
        "type": "string",
        "location": "config",
        "required": true,
        "secret": false,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "account_models": [
          "per_user"
        ]
      },
      {
        "name": "client_secret",
        "label": "Client secret",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^\\S+$",
        "min_length": 1,
        "max_length": 4096,
        "account_models": [
          "per_user"
        ]
      },
      {
        "name": "api_key",
        "label": "API key",
        "type": "string",
        "location": "credential",
        "required": true,
        "secret": true,
        "pattern": "^\\S+$",
        "min_length": 1,
        "max_length": 4096,
        "credential_sources": [
          "opaque_ref"
        ]
      }
    ]
  }
]
