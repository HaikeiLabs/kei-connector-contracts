        ],
        "default_account_model": "per_user"
      },
      {
        "credential_source": "opaque_ref",
        "account_models": [
          "domain_delegation"
        ]
      }
    ],
    "fields": [
      {
        "name": "drive_id",
        "label": "Drive ID",
        "type": "string",
        "location": "config",
        "required": false,
        "secret": false,
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      {
        "name": "impersonate_email",
        "label": "Mailbox to impersonate",
        "type": "email",
        "location": "config",
        "required": true,
        "secret": false,
        "max_length": 254,
        "account_models": [
          "domain_delegation"
        ]
      },
      {
        "name": "service_account_key",
        "label": "Service account key (JSON)",
        "type": "service_account_json",
        "location": "credential",
        "required": true,
        "secret": true,
        "max_length": 16384,
        "account_models": [
          "domain_delegation"
        ]
      }
    ]
  },
