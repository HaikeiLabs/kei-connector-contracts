[
  {
    "schema": "kei.connector-setup/v1",
    "provider": "gmail",
    "auth": [
      {
        "credential_source": "oauth",
        "account_models": [
          "per_user",
          "shared"
        ],
        "default_account_model": "per_user"
      },
      {
        "credential_source": "opaque_ref",
        "account_models": [
          "domain_delegation"
        ]
      }
    ],
    "fields": [
      {
        "name": "include_body",
        "label": "Return message bodies from message.get",
        "type": "bool",
        "location": "config",
        "required": false,
        "secret": false,
        "default": false
      },
      {
        "name": "impersonate_email",
        "label": "Mailbox to impersonate",
        "type": "email",
        "location": "config",
        "required": true,
        "secret": false,
        "max_length": 254,
        "account_models": [
          "domain_delegation"
        ]
      },
      {
        "name": "service_account_key",
        "label": "Service account key (JSON)",
        "type": "service_account_json",
        "location": "credential",
        "required": true,
        "secret": true,
        "max_length": 16384,
        "account_models": [
          "domain_delegation"
        ]
      }
    ]
  },
  {
    "schema": "kei.connector-setup/v1",
