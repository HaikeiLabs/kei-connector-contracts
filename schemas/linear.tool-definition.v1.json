[
  {
    "schema": "kei.tool-definition/v1",
    "name": "linear.list_issues",
    "description": "List issues in the governed Linear workspace",
    "parameters": [
      {
        "name": "state",
        "description": "Filter by workflow state",
        "type": "string",
        "required": false,
        "enum": ["backlog", "unstarted", "started", "done", "canceled"]
      },
      {
        "name": "priority",
        "description": "Filter by priority",
        "type": "string",
        "required": false,
        "enum": ["urgent", "high", "medium", "low", "none"]
      },
      {
        "name": "assignee",
        "description": "Filter by assignee display name",
        "type": "string",
        "required": false
      },
      {
        "name": "limit",
        "description": "Maximum number of issues to return",
        "type": "integer",
        "required": false,
        "default": 50
      }
    ],
    "permission": "linear.read",
    "category": "linear",
    "service": "linear",
    "version": "1.0.0",
    "tags": ["linear-read", "governed-connector"],
    "binding": {
      "connector_id": "conn_linear_1",
      "config": {
        "resource": "issues"
      },
      "delegated_context": ["tenant_id", "workspace"],
      "transport": {
        "method": "POST",
        "url_template": "https://api.linear.app/graphql",
        "auth": {
          "placement": "header",
          "name": "Authorization",
          "scheme": "Bearer"
        },
        "args": {
          "state": {
            "in": "body",
            "name": "variables.filter.state"
          },
          "priority": {
            "in": "body",
            "name": "variables.filter.priority"
          },
          "assignee": {
            "in": "body",
            "name": "variables.filter.assignee"
          },
          "limit": {
            "in": "body",
            "name": "variables.first"
          }
        }
      }
    }
  },
  {
    "schema": "kei.tool-definition/v1",
    "name": "linear.get_issue",
    "description": "Read a single issue by its key in the governed Linear workspace. Use it when the user asks about an issue (status, details); do not call it just because a request mentions an issue key",
    "parameters": [
      {
        "name": "issue_key",
        "description": "Issue key, e.g. ENG-123",
        "type": "string",
        "required": true
      }
    ],
    "permission": "linear.read",
    "category": "linear",
    "service": "linear",
    "version": "1.0.0",
    "tags": ["linear-read", "governed-connector"],
    "binding": {
      "connector_id": "conn_linear_1",
      "config": {
        "resource": "issues"
      },
      "delegated_context": ["tenant_id", "workspace"],
      "transport": {
        "method": "POST",
        "url_template": "https://api.linear.app/graphql",
        "auth": {
          "placement": "header",
          "name": "Authorization",
          "scheme": "Bearer"
        },
        "args": {
          "issue_key": {
            "in": "body",
            "name": "variables.id"
          }
        }
      }
    }
  },
  {
    "schema": "kei.tool-definition/v1",
    "name": "linear.list_projects",
    "description": "List projects in the governed Linear workspace",
    "parameters": [
      {
        "name": "state",
        "description": "Filter by project state",
        "type": "string",
        "required": false,
        "enum": ["backlog", "planned", "started", "paused", "completed", "canceled"]
      },
      {
        "name": "limit",
        "description": "Maximum number of projects to return",
        "type": "integer",
        "required": false,
        "default": 50
      }
    ],
    "permission": "linear.read",
    "category": "linear",
    "service": "linear",
    "version": "1.0.0",
    "tags": ["linear-read", "governed-connector"],
    "binding": {
      "connector_id": "conn_linear_1",
      "config": {
        "resource": "projects"
      },
      "delegated_context": ["tenant_id", "workspace"],
      "transport": {
        "method": "POST",
        "url_template": "https://api.linear.app/graphql",
        "auth": {
          "placement": "header",
          "name": "Authorization",
          "scheme": "Bearer"
        },
        "args": {
          "state": {
            "in": "body",
            "name": "variables.filter.state"
          },
          "limit": {
            "in": "body",
            "name": "variables.first"
          }
        }
      }
    }
  },
  {
    "schema": "kei.tool-definition/v1",
    "name": "linear.create_issue",
    "description": "Create an issue in a team of the governed Linear workspace. Use to track work such as a bug, review, or follow-up task.",
    "parameters": [
      {
        "name": "team_key",
        "description": "Key of the Linear team that owns the issue (the prefix of its issue keys, e.g. KEI for KEI-123)",
        "type": "string",
        "required": true
      },
      {
        "name": "title",
        "description": "Issue title",
        "type": "string",
        "required": true
      },
      {
        "name": "description",
        "description": "Issue body in Markdown",
        "type": "string",
        "required": false
      },
      {
        "name": "priority",
        "description": "Issue priority",
        "type": "string",
        "required": false,
        "enum": ["urgent", "high", "medium", "low", "none"]
      },
      {
        "name": "labels",
        "description": "Comma-separated label names",
        "type": "string",
        "required": false
      }
    ],
    "permission": "linear.write",
    "category": "linear",
    "service": "linear",
    "version": "1.0.0",
    "tags": ["linear-write", "governed-action"],
    "binding": {
      "connector_id": "conn_linear_1",
      "transport": {
        "method": "POST",
        "url_template": "https://api.linear.app/graphql",
        "auth": {
          "placement": "header",
          "name": "Authorization",
          "scheme": "Bearer"
        },
        "args": {
          "team_key": {
            "in": "body",
            "name": "variables.input.teamId"
          },
          "title": {
            "in": "body",
            "name": "variables.input.title"
          },
          "description": {
            "in": "body",
            "name": "variables.input.description"
          },
          "priority": {
            "in": "body",
            "name": "variables.input.priority"
          },
          "labels": {
            "in": "body",
            "name": "variables.input.labelIds"
          }
        }
      }
    }
    }
]
