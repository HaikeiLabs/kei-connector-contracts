{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HaikeiLabs/kei-connector-contracts/schemas/connector-manifest.v1.schema.json",
  "title": "kei.connector-manifest/v1",
  "description": "Connectors, connection kinds, setup fields, operations as capabilities, and the legacy capability mapping. Generated by protoc-gen-kei-manifest (proposal 0002, section 4.6); the policy catalog ingests it at build time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contracts_version", "connectors", "legacy_capabilities"],
  "properties": {
    "schema": { "const": "kei.connector-manifest/v1" },
    "contracts_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "connectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/connector" }
    },
    "legacy_capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/legacy_row" }
    }
  },
  "$defs": {
    "connector_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "operation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "connections", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/connector_id" },
        "base_url": { "type": "string", "pattern": "^https?://" },
        "connections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/connection" } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "auth_method", "account_model", "scopes", "setup_fields"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": {
          "enum": ["http_bearer", "http_header", "http_basic", "sql_dsn", "key_pair_jwt", "token_exchange"]
        },
        "auth_method": { "type": "string" },
        "account_model": { "enum": ["per_user", "shared"] },
        "base_url": { "type": "string", "pattern": "^https?://" },
        "base_url_field": { "type": "string", "minLength": 1 },
        "header_name": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "scopes": { "$ref": "#/$defs/strings" },
        "setup_fields": { "type": "array", "items": { "$ref": "#/$defs/setup_field" } }
      }
    },
    "setup_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "secret"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "secret": { "type": "boolean" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "class", "destructive", "deprecated", "replaced_by", "scopes",
        "connections", "resource_template", "semantics", "request", "response"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/operation_id" },
        "class": { "enum": ["read", "write"] },
        "destructive": { "type": "boolean" },
        "deprecated": { "type": "boolean" },
        "replaced_by": {
          "anyOf": [{ "const": "" }, { "$ref": "#/$defs/operation_id" }]
        },
        "scopes": { "$ref": "#/$defs/strings" },
        "connections": { "allOf": [{ "$ref": "#/$defs/strings" }, { "minItems": 1 }] },
        "resource_template": { "type": "string" },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "resource_type", "version"],
          "properties": {
            "action": { "enum": ["read", "create", "update", "delete"] },
            "resource_type": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        "request": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*Request$" },
        "response": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*Response$" }
      }
    },
    "legacy_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector", "capability", "operations"],
      "properties": {
        "connector": { "$ref": "#/$defs/connector_id" },
        "capability": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation_id" } }
      }
    }
  }
}
