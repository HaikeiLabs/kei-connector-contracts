{
  "description": "kei.harness-match/v1 fixture set",
  "semantics": "kei.harness-match/v1",
  "cases": [
    {
      "id": "permit-simple-exact-tool",
      "desc": "exact tool match, permit",
      "call": { "kind": "claude_code", "tool": "claude_code.edit" },
      "policies": [{ "id": "p1", "src": "*", "dst": "tool:claude_code.edit", "action": "permit", "enabled": true }],
      "want_outcome": "permit",
      "want_policy": "p1"
    },
    {
      "id": "deny-simple-tool",
      "desc": "exact tool match, deny",
      "call": { "kind": "codex", "tool": "codex.shell" },
      "policies": [{ "id": "p1", "src": "*", "dst": "tool:codex.shell", "action": "deny", "enabled": true }],
      "want_outcome": "deny",
      "want_policy": "p1"
    },
    {
      "id": "unmatched-no-policy",
      "desc": "no matching policy",
      "call": { "kind": "claude_code", "tool": "claude_code.read" },
      "policies": [{ "id": "p1", "src": "*", "dst": "tool:claude_code.edit", "action": "permit", "enabled": true }],
      "want_outcome": "unmatched"
    },
    {
      "id": "unsupported-kind",
      "desc": "unknown harness kind",
      "call": { "kind": "vim" },
      "policies": [],
      "want_outcome": "not_renderable",
      "want_reason": "unsupported_kind"
    },
    {
      "id": "custom-kind-evaluate-via-pdp",
