{
  "schema": "kei.tool-manifest/v3",
  "tools": [
    {
      "name": "discord.get_message",
      "source": "discord",
      "operation_class": "read",
      "route": {"connector_binding": {"agent_id": "agent-discord", "connector_id": "discord-installation-binding"}},
      "required_capabilities": ["message.read", "channel.read"],
      "resource_types": [{"type": "message", "parent_type": "channel"}]
    },
    {
      "name": "discord.list_messages",
      "source": "discord",
      "operation_class": "read",
      "route": {"connector_binding": {"agent_id": "agent-discord", "connector_id": "discord-installation-binding"}},
      "required_capabilities": ["message.read"],
      "resource_types": [{"type": "message", "parent_type": "channel"}]
    },
    {
      "name": "harness.open_file",
      "source": "local",
      "operation_class": "read",
      "route": {"harness_executor": {"executor": "codex", "registration": "harness.open_file"}}
    }
  ]
}
